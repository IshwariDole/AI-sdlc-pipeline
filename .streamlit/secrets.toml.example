# Copy to .streamlit/secrets.toml for LOCAL testing of the secrets-bridging
# code path only. Never commit the real secrets.toml.
#
# For an actual PUBLIC deployment, you generally do NOT want to set API keys
# here at all -- see DEPLOY.md for why (a server-side key becomes a single
# shared quota that one busy visitor can exhaust for everyone else). Use this
# file for things that ARE safe to share across all visitors, like defaults:

BRS2SPRINT_HOSTED = "true"
TEAM_VELOCITY = "20"
MAX_SPRINTS = "20"
LLM_MAX_TOKENS = "2000"

# Only set a provider key here if you specifically want a single shared
# server key for a low-traffic private demo (e.g. an internal team tool
# behind Streamlit Cloud's viewer-restriction feature), understanding that
# all visitors will share its rate limit:
# GROQ_API_KEY = "gsk_..."
